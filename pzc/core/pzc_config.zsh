# Config config dir.
# ------------------------------------------------------------------------------



if [[ ! -v PZC_PZC_CONFIG_DIR ]]
then
  PZC_PZC_CONFIG_DIR=${HOME}/.config/pzc
fi

if [[ ! -v PZC_PZC_CACHE_DIR ]]
then
  PZC_PZC_CACHE_DIR=${HOME}/.cache/pzc
fi

PZC_PZC_CONFIG_FILE=${PZC_PZC_CACHE_DIR}/config.pzc
PZC_PZC_CONFIG_FILE_V8=${PZC_PZC_CONFIG_DIR}/config.json



function _pzc_regenerate_config()
{
  source ${PZC_PZC_DIR}/pzc/version.zsh
  if [[ ! -e ${PZC_PZC_CONFIG_FILE_V8} ]]
  then
    _pzc_error "config.json not found"
    return 1
  fi

  # ---------------------------------------

  rm -f ${PZC_PZC_CONFIG_FILE}
  _pzc_info "Generating config file..."
  echo "# Generated by PZC. Do not edit." >> ${PZC_PZC_CONFIG_FILE}
  echo "local _PZC_CONFIG_VERSION=(${_PZC_CONFIG_LAST_VERSION})" >> ${PZC_PZC_CONFIG_FILE}


  # ---------------------------------------

  source ${PZC_PZC_DIR}/pzc/core/gen_config_general.zsh
  _pzc_generate_config_general
  if [[ ${_PZC_FATAL_ERROR} = 1 ]]
  then
    return 0
  fi
  unfunction _pzc_generate_config_general

  # ---------------------------------------

  source ${PZC_PZC_DIR}/pzc/core/gen_config_pkgs_mng.zsh
  _pzc_generate_config_pkgs_mng
  if [[ ${_PZC_FATAL_ERROR} = 1 ]]
  then
    return 0
  fi
  unfunction _pzc_generate_config_pkgs_mng

  # ---------------------------------------

  source ${PZC_PZC_DIR}/pzc/core/gen_config_pkgs.zsh
  _pzc_generate_config_pkgs
  if [[ ${_PZC_FATAL_ERROR} = 1 ]]
  then
    return 0
  fi
  unfunction _pzc_generate_config_pkgs
}



function pzc_regenerate_config()
{
  _pzc_regenerate_config
  _pzc_info "Reloading ZSH..."
  exec zsh
}



function pzc_config
{
  _pzc_coal_eval "${PZC_FILE_EDITOR} ${PZC_PZC_CONFIG_FILE_V8}"
  _pzc_info "Call pzc_regenerate_config to regenerate the configuration ?"

  read -q "REPLY?(y/n)"
  echo ""
  if [[ ${REPLY} != "y" ]]
  then
    unset REPLY
    return 0
  fi
  unset REPLY
  pzc_regenerate_config
}




function _pzc_config()
{
  if [[ ${_PZC_IS_DEV_VERSION} = 1 ]]
  then
    _pzc_warning "You using a development version of PZC, save your config files before continuing."
    read -q "REPLY? Launching minimal version to backup config? (y/n)"
    echo ""
    if [[ ${REPLY} != "n" ]]
    then
      unset REPLY
      _PZC_FATAL_ERROR=1
      return 0
    fi
    unset REPLY
  fi

  if [[ ! -e "${PZC_PZC_CONFIG_DIR}" ]]
  then
    mkdir -p "${PZC_PZC_CONFIG_DIR}"
    if [[ $? != 0 ]]
    then
      _pzc_error "Error mkdir config dir"
      _PZC_FATAL_ERROR=1
      return 0
    fi
  fi



  # Check update...
  source ${PZC_PZC_DIR}/pzc/core/update/pzc_update.zsh
  _pzc_check_update
  if [[ ${_PZC_FATAL_ERROR} = 1 ]]
  then
    _pzc_error "Error update"
    _PZC_FATAL_ERROR=1
    return 0
  fi
  unfunction _pzc_check_update




  if [[ ! -e "${PZC_PZC_CONFIG_FILE_V8}" ]]
  then
    _pzc_info "Configuration file not found. Creating this file..."
    cp ${PZC_PZC_DIR}/templates/config.json ${PZC_PZC_CONFIG_FILE_V8}
    _pzc_info "Your configuration file is available here: ${PZC_PZC_CONFIG_FILE_V8}"
    _pzc_info "You can edit it with 'pzc_config' command."
    read -s -k $'?Press any key to continue.\n'
  fi

  if [[ ! -e "${PZC_PZC_CONFIG_FILE}" ]]
  then
    _pzc_info "Internal configuration file not found. Creating this file..."
    _pzc_regenerate_config
  fi
}
